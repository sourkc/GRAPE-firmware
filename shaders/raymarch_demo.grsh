uniform float time;

float sd_sphere(vec3 p, vec3 center, float radius)
{
    return length(p - center) - radius;
}

float map_scene(vec3 p, vec3 center0, vec3 center1, vec3 center2)
{
    float floor_distance = p.y;
    float sphere0 = sd_sphere(p, center0, 0.68);
    float sphere1 = sd_sphere(p, center1, 0.48);
    float sphere2 = sd_sphere(p, center2, 0.34);

    return min(floor_distance, min(sphere0, min(sphere1, sphere2)));
}

vec3 scene_normal(vec3 p, vec3 center0, vec3 center1, vec3 center2)
{
    float e = 0.0035;
    vec3 e0 = vec3(1.0, -1.0, -1.0);
    vec3 e1 = vec3(-1.0, -1.0, 1.0);
    vec3 e2 = vec3(-1.0, 1.0, -1.0);
    vec3 e3 = vec3(1.0, 1.0, 1.0);

    vec3 normal =
        e0 * map_scene(p + e0 * e, center0, center1, center2) +
        e1 * map_scene(p + e1 * e, center0, center1, center2) +
        e2 * map_scene(p + e2 * e, center0, center1, center2) +
        e3 * map_scene(p + e3 * e, center0, center1, center2);

    return normalize(normal);
}

vec3 sky_color(vec3 direction)
{
    float horizon = clamp(direction.y * 0.5 + 0.5, 0.0, 1.0);
    vec3 low = vec3(0.015, 0.025, 0.070);
    vec3 high = vec3(0.16, 0.34, 0.72);
    vec3 sky = mix(low, high, horizon);

    vec3 sun_direction = vec3(-0.456, 0.730, -0.527);
    float sun = pow(max(dot(direction, sun_direction), 0.0), 96.0);
    return sky + vec3(1.0, 0.72, 0.38) * sun * 2.2;
}

vec3 surface_color(vec3 p, vec3 center0, vec3 center1, vec3 center2)
{
    if (p.y < 0.015) {
        float checker = fract((floor(p.x * 1.8) + floor(p.z * 1.8)) * 0.5) * 2.0;
        return mix(vec3(0.035, 0.045, 0.070), vec3(0.16, 0.19, 0.24), checker);
    }

    float d0 = abs(sd_sphere(p, center0, 0.68));
    float d1 = abs(sd_sphere(p, center1, 0.48));
    float d2 = abs(sd_sphere(p, center2, 0.34));

    if (d0 < d1 && d0 < d2)
        return vec3(0.08, 0.48, 0.95);
    if (d1 < d2)
        return vec3(0.92, 0.14, 0.30);
    return vec3(0.18, 0.88, 0.56);
}

vec4 main()
{
    float aspect = surface_size.x / surface_size.y;
    vec2 screen = vec2(
        (uv.x * 2.0 - 1.0) * aspect,
        1.0 - uv.y * 2.0
    );

    vec3 center0 = vec3(
        -0.95 + 0.18 * sin(time * 0.9),
        0.68 + 0.08 * sin(time * 1.3),
        0.10
    );
    vec3 center1 = vec3(
        0.78,
        0.48 + 0.10 * cos(time * 1.1),
        -0.55 + 0.16 * sin(time * 0.7)
    );
    vec3 center2 = vec3(
        0.10 + 0.14 * cos(time * 0.8),
        0.34,
        0.82
    );

    float camera_angle = time * 0.22;
    vec3 ray_origin = vec3(
        cos(camera_angle) * 4.2,
        2.0 + 0.15 * sin(time * 0.35),
        sin(camera_angle) * 4.2
    );
    vec3 target = vec3(0.0, 0.62, 0.05);

    vec3 forward = normalize(target - ray_origin);
    vec3 right = normalize(cross(forward, vec3(0.0, 1.0, 0.0)));
    vec3 up = cross(right, forward);
    mat3 camera = mat3(right, up, forward);
    vec3 ray_direction = normalize(camera * vec3(screen, 1.85));

    float travel = 0.0;
    bool hit = false;

    for (int i = 0; i < 48; i++) {
        vec3 sample_position = ray_origin + ray_direction * travel;
        float distance = map_scene(sample_position, center0, center1, center2);

        if (distance < 0.0025) {
            hit = true;
            break;
        }

        travel += distance;
        if (travel > 12.0)
            break;
    }

    vec3 background = sky_color(ray_direction);
    if (!hit)
        return vec4(background, 1.0);

    vec3 position = ray_origin + ray_direction * travel;
    vec3 normal = scene_normal(position, center0, center1, center2);
    vec3 light_direction = vec3(-0.456, 0.730, -0.527);

    float diffuse = max(dot(normal, light_direction), 0.0);
    vec3 half_direction = normalize(light_direction - ray_direction);
    float specular = pow(max(dot(normal, half_direction), 0.0), 48.0);

    vec3 base = surface_color(position, center0, center1, center2);
    vec3 reflected = sky_color(reflect(ray_direction, normal));

    float facing = clamp(1.0 + dot(normal, ray_direction), 0.0, 1.0);
    float fresnel = pow(facing, 5.0);
    float reflection_amount = 0.28 + fresnel * 0.48;

    vec3 color = base * (0.18 + diffuse * 1.05);
    color = mix(color, reflected, reflection_amount);
    color += vec3(1.0, 0.86, 0.68) * specular * 1.6;

    float fog = 1.0 - exp(-0.018 * travel * travel);
    color = mix(color, background, clamp(fog, 0.0, 1.0));

    return vec4(color, 1.0);
}
