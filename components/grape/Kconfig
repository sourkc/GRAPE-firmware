menu "GRAPE"

    config GRAPE_MAX_DAMAGE_RECTS
        int "Maximum render damage rectangles"
        range 1 128
        default 16

    config GRAPE_DAMAGE_TILE_SIZE
        int "Damage tile size (pixels)"
        range 4 64
        default 16

    config GRAPE_DAMAGE_RECT_OVERHEAD_PIXELS
        int "Estimated fixed cost per render rectangle (pixel equivalents)"
        range 0 65536
        default 1024

    config GRAPE_TEXTURE_OCCUPANCY_CELL_SIZE
        int "Texture occupancy cell size (texels)"
        range 2 64
        default 8
        help
            A8 textures are scanned into a coarse occupancy bitmap using
            square cells of this size. Smaller cells give tighter damage
            coverage for rotated and irregular textures at higher CPU cost.

    choice GRAPE_TEXTURE_DEFAULT_MEMORY
        prompt "Default texture memory"
        default GRAPE_TEXTURE_DEFAULT_PSRAM

        config GRAPE_TEXTURE_DEFAULT_PSRAM
            bool "PSRAM"

        config GRAPE_TEXTURE_DEFAULT_INTERNAL
            bool "Internal RAM"
    endchoice

endmenu
