menu "GRAPE"

    config GRAPE_GPU_MULTICORE
        bool "Use opportunistic Core 1 GPU tile worker"
        depends on !FREERTOS_UNICORE && !GRAPE_FUNCTION_PROFILING
        default y
        help
            Keep GPU command processing and the primary worker on Core 0.
            A priority-1 helper on Core 1 drains prepared MSAA tile jobs,
            below GFXLINK (4) and TinyUSB (5), and sleeps between batches.
            Disable for single-worker comparisons. Function profiling uses
            a single-writer table, so it retains the single-worker path.

    config GRAPE_MAX_DAMAGE_RECTS
        int "Maximum render damage rectangles"
        range 1 128
        default 16

    config GRAPE_DAMAGE_TILE_SIZE
        int "Damage tile size (pixels)"
        range 4 64
        default 16

    config GRAPE_DAMAGE_RECT_OVERHEAD_PIXELS
        int "Estimated fixed cost per render rectangle (pixel equivalents)"
        range 0 65536
        default 1024

    config GRAPE_FUNCTION_PROFILING
        bool "Enable automatic function call profiling"
        default n
        help
            Instrument GRAPE functions and count calls during benchmark
            measurement passes. This significantly changes benchmark timing,
            so timing results from profiling builds should not be compared with
            normal benchmark results.

    config GRAPE_FUNCTION_PROFILE_MAX_FUNCTIONS
        int "Maximum simultaneously profiled GRAPE functions"
        depends on GRAPE_FUNCTION_PROFILING
        range 64 4096
        default 1024
        help
            Number of unique function addresses the fixed profiling table can
            retain during one benchmark case.

    config GRAPE_TEXTURE_OCCUPANCY_CELL_SIZE
        int "Texture occupancy cell size (texels)"
        range 2 64
        default 8
        help
            A8 textures are scanned into a coarse occupancy bitmap using
            square cells of this size. Smaller cells give tighter damage
            coverage for rotated and irregular textures at higher CPU cost.

    choice GRAPE_TEXTURE_DEFAULT_MEMORY
        prompt "Default texture memory"
        default GRAPE_TEXTURE_DEFAULT_PSRAM

        config GRAPE_TEXTURE_DEFAULT_PSRAM
            bool "PSRAM"

        config GRAPE_TEXTURE_DEFAULT_INTERNAL
            bool "Internal RAM"
    endchoice

endmenu
